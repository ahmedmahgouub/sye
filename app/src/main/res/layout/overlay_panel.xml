<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="264dp"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- الهيدر العلوي: لوجو + عنوان + مؤشر حالة + زر إغلاق/تصغير -->
    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_shield" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_icon_circle_accent" />

        <ImageButton
            android:id="@+id/btnMinimize"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/close_panel"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />

    </LinearLayout>

    <!-- شبكة أزرار الأدوات الـ 12 بترتيب عمودين (مطابق للصورة بالمللي: عمود فردي وعمود زوجي) -->
    <GridLayout
        android:id="@+id/gridTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="6"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="true">

        <!-- الصف الأول -->
        <Button android:id="@+id/btnTool0" style="@style/HudToggleButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginEnd="6dp" android:text="رقم 1" />
        <Button android:id="@+id/btnTool1" style="@style/HudToggleButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginStart="6dp" android:text="رقم 2" />

        <!-- الصف الثاني -->
        <Button android:id="@+id/btnTool2" style="@style/HudToggleButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginEnd="6dp" android:text="رقم 3" />
        <Button android:id="@+id/btnTool3" style="@style/HudToggleButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginStart="6dp" android:text="رقم 4" />

        <!-- الصف الثالث -->
        <Button android:id="@+id/btnTool4" style="@style/HudToggleButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginEnd="6dp" android:text="رقم 5" />
        <Button android:id="@+id/btnTool5" style="@style/HudToggleButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginStart="6dp" android:text="رقم 6" />

        <!-- الصف الرابع -->
        <Button android:id="@+id/btnTool6" style="@style/HudToggleButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginEnd="6dp" android:text="رقم 7" />
        <Button android:id="@+id/btnTool7" style="@style/HudToggleButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginStart="6dp" android:text="رقم 8" />

        <!-- الصف الخامس -->
        <Button android:id="@+id/btnTool8" style="@style/HudToggleButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginEnd="6dp" android:text="رقم 9" />
        <Button android:id="@+id/btnTool9" style="@style/HudToggleButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginStart="6dp" android:text="رقم 10" />

        <!-- الصف السادس والأخير (الخيارات الإضافية مثل الصورة: تم، خط، الحبل) -->
        <Button android:id="@+id/btnTool10" style="@style/HudToggleButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginEnd="6dp" android:text="الحبل" />
        <Button android:id="@+id/btnTool11" style="@style/HudToggleButton" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginStart="6dp" android:text="تم" />

    </GridLayout>

    <!-- فاصل جمالي خفيف -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="#22FFFFFF" />

    <!-- قسم محاذاة الأساسيات (Core Alignment) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/section_core_align"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/radioCoreAlign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <RadioButton android:id="@+id/rbAlignBottom" style="@style/HudRadioButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/align_bottom" />
        <RadioButton android:id="@+id/rbAlignMid" style="@style/HudRadioButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/align_mid" />
        <RadioButton android:id="@+id/rbAlignTop" style="@style/HudRadioButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/align_top" />
        <RadioButton android:id="@+id/rbAlignOff" style="@style/HudRadioButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/align_off" />

    </RadioGroup>

    <!-- قسم الحالة (Status) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/section_status"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/radioStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <RadioButton android:id="@+id/rbStatusPrcs" style="@style/HudRadioButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/status_prcs" />
        <RadioButton android:id="@+id/rbStatusFill" style="@style/HudRadioButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/status_fill" />
        <RadioButton android:id="@+id/rbStatusOff" style="@style/HudRadioButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/status_off" />

    </RadioGroup>

</LinearLayout>
